 "html": "<div id=\"header-html\" class=\"visible-pdf\">\r\n<table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; margin-top:-50px;\">\r\n    <tr style=\"margin:0; padding:0;\">\r\n\r\n        <!-- LOGO -->\r\n        <td style=\"width: 33.33%; vertical-align: top; text-align: left; padding: 0;\">\r\n            {% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n            \r\n            {% if company_logo %}\r\n                <div style=\"height: 84px; overflow: hidden; position: relative; width: 100%;\">\r\n                    <img src=\"{{ company_logo }}\" alt=\"{{ doc.company }}\"\r\n                         style=\"position: absolute; top: -18px; left: 0; height: 120px; width: auto;\">\r\n                </div>\r\n            {% endif %}\r\n        </td>\r\n\r\n\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:bottom; text-align:center; font-size:25px; font-weight:400; color:#222; white-space:nowrap;\">\r\n            Purchase Invoice\r\n        </td>\r\n\r\n        <!-- ADDRESS -->\r\n        <td style=\"width: 33.33%; vertical-align: top; text-align: right; font-size: 12px; line-height: 1.4; padding: 0;\">\r\n\r\n            {% set company_address = frappe.db.get_value(\r\n                \"Address\",\r\n                doc.billing_address, \r\n                [\"address_line1\", \"city\", \"state\", \"pincode\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            {% if company_address %}\r\n                {{ company_address.address_line1 or \"\" }}<br>\r\n                {{ company_address.city or \"\" }},\r\n                {{ company_address.state or \"\" }},\r\n                {{ company_address.pincode or \"\" }}<br>\r\n            {% endif %}\r\n\r\n            {% set company_details = frappe.db.get_value(\r\n                \"Company\",\r\n                doc.company,\r\n                [\"website\", \"phone_no\", \"fax\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            TEL: {{ company_details.phone_no or \"\" }},<br>\r\n            FAX {{ company_details.fax or \"\" }}<br>\r\n            \r\n            {{ company_details.website or \"\" }}\r\n        </td>\r\n\r\n    </tr>\r\n</table>\r\n\r\n<div style=\"border-top:2px solid #222; margin:0; padding:0;\"></div>\r\n<div style=\"border-top:3px solid #222; margin:4px 0 0 0; padding:0;\"></div>\r\n\r\n    <table style=\"width:100%; border-collapse:collapse; font-size:10px; margin-top:10px;\">\r\n        <tr style=\"background-color:#e6e6e6; color:black;\">\r\n            <th style=\"border:1px solid black; padding:3px; text-align:center; color: black;\">\r\n                PURCHASE ORDER NUMBER\r\n            </th>\r\n            <th style=\"border:1px solid black; padding:3px; text-align:center; color: black;\">\r\n                DATE ISSUED\r\n            </th>\r\n            <th style=\"border:1px solid black; padding:3px; text-align:center; color: black;\">\r\n                PAGE NUMBER\r\n            </th>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td style=\"border:1px solid black; padding:3px; text-align:center;\">\r\n                <b>{{ doc.name }}</b>\r\n            </td>\r\n\r\n            <td style=\"border:1px solid black; padding:3px; text-align:center;\">\r\n                {{ frappe.utils.formatdate(doc.posting_date, \"dd MMMM yyyy\") }}\r\n            </td>\r\n\r\n            <td style=\"border:1px solid black; padding:3px; text-align:center;\">\r\n                Page <span class=\"page\"></span> of <span class=\"topage\"></span>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n<!-- Vendor and Ship To Section -->\r\n<table style=\"width:100%; border-collapse: collapse; margin-top:5px; font-size:10px;\">\r\n    <tr>\r\n        <td style=\"width:50%; border:1px solid black; padding:5px; vertical-align:top;\">\r\n            <b>TO:</b><br>\r\n            <b>{{ doc.supplier }}</b><br>\r\n            {{ doc.address_display or doc.supplier_address_display or \"\" }}<br>\r\n            {{ doc.contact_display or \"\" }}<br>\r\n            <strong>Email:</strong> {{ doc.contact_email or \"\" }}\r\n        </td>\r\n        <td style=\"width:50%; border:1px solid black; padding:5px; vertical-align:top;\">\r\n            <b>SHIP TO:</b><br>\r\n            {{ doc.shipping_address_display or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table style=\"width:100%; border-collapse: collapse; margin-top:5px; font-size:10px;\">\r\n    <tr style=\"background-color:#e6e6e6; color:black;\">\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; width:20%; color: black;\">DUE DATE</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; width:20%; color: black;\">SHIP VIA</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; width:20%; color: black;\">TERMS</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; width:20%; color: black;\">BUYER</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; width:20%; color: black;\">CONFIRMING TO:</th>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ frappe.utils.formatdate(doc.due_date, \"dd MMM yyyy\") if doc.due_date else \"\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.shipping_rule or \"\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.payment_terms_template or doc.tc_name or \"\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.owner or \"\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.custom_confirming_to or \"\" }}</td>\r\n    </tr>\r\n    <tr style=\"background-color:#e6e6e6; color:black;\">\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; color: black;\">FOB DESTINATION</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; color: black;\">FOB SHIPPING POINT</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; color: black;\">TAXABLE / NON TAXABLE</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; color: black;\">SALES TAX EXEMPT #</th>\r\n        <th style=\"border:1px solid black; padding:2px; text-align:center; color: black;\">VENDOR NUMBER</th>\r\n    </tr>\r\n    <tr>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">\r\n            {% if doc.custom_fob == 'Destination' or not doc.custom_fob %}X{% endif %}\r\n        </td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">\r\n            {% if doc.custom_fob == 'Shipping Point' %}X{% endif %}\r\n        </td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ \"Taxable\" if not doc.taxes_and_charges else \"Non-Taxable\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.custom_tax_exempt_number or \"\" }}</td>\r\n        <td style=\"border:1px solid black; padding:2px; text-align:center;\">{{ doc.supplier or \"\" }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- ITEMS TABLE (5 Columns) -->\r\n<table style=\"width: 100%; border-collapse: collapse; font-size: 12px; margin-top:5px; font-family: sans-serif; text-align: center; line-height: 1.2;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"padding: 8px 4px; border: 1px solid #222; background-color: #e6e6e6; width: 20%; color: black;\">\r\n                Item\r\n            </th>\r\n            <th style=\"padding: 8px 4px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; color: black;\">\r\n                Quantity\r\n            </th>\r\n            <th style=\"padding: 8px 4px; border: 1px solid #222; background-color: #e6e6e6; width: 40%; color: black;\">\r\n                Description\r\n            </th>\r\n            <th style=\"padding: 8px 4px; border: 1px solid #222; background-color: #e6e6e6; width: 15%; color: black;\">\r\n                Unit Price\r\n            </th>\r\n            <th style=\"padding: 8px 4px; border: 1px solid #222; background-color: #e6e6e6; width: 15%; color: black;\">\r\n                Total Amount\r\n            </th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <!-- ITEM -->\r\n            <td style=\"padding: 8px 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.item_code }}\r\n            </td>\r\n            \r\n            <!-- QUANTITY -->\r\n            <td style=\"padding: 8px 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"{:,.0f}\".format(item.qty) if item.qty else \"0\" }}\r\n            </td>\r\n            \r\n            <!-- DESCRIPTION -->\r\n            <td style=\"padding: 8px 4px; border: 1px solid #222; vertical-align: top; text-align: left;\">\r\n                {{ item.description or item.item_name or \"\" }}\r\n            </td>\r\n            \r\n            <!-- UNIT PRICE -->\r\n            <td style=\"padding: 8px 4px; border: 1px solid #222; vertical-align: top;\">\r\n                $ {{ \"{:,.2f}\".format(item.rate) if item.rate else \"0.00\" }}\r\n            </td>\r\n            \r\n            <!-- TOTAL AMOUNT -->\r\n            <td style=\"padding: 8px 4px; border: 1px solid #222; vertical-align: top;\">\r\n                $ {{ \"{:,.2f}\".format(item.amount) if item.amount else \"0.00\" }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<!-- BOTTOM SECTION (3 Columns) -->\r\n<table style=\"width: 100%; border-collapse: collapse; margin-top:5px; font-size: 12px; font-family: sans-serif; text-align: center; line-height: 1.2;\">\r\n    <tr>\r\n        <!-- HEADERS -->\r\n        <td style=\"padding: 6px 4px; border: 1px solid #222; background-color: #e6e6e6; color: black; width: 33.33%; font-weight: bold;\">\r\n            AUTHORIZED SIGNATURE\r\n        </td>\r\n        <td style=\"padding: 6px 4px; border: 1px solid #222; background-color: #e6e6e6; color: black; width: 33.33%; font-weight: bold;\">\r\n            ACCOUNT NUMBER\r\n        </td>\r\n        <td style=\"padding: 6px 4px; border: 1px solid #222; background-color: #e6e6e6; color: black; width: 33.33%; font-weight: bold;\">\r\n            IN PLANT DESTINATION\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <!-- EMPTY FILLABLE ROWS -->\r\n        <td style=\"padding: 15px 4px; border: 1px solid #222;\"><br></td>\r\n        <td style=\"padding: 15px 4px; border: 1px solid #222;\"><br></td>\r\n        <td style=\"padding: 15px 4px; border: 1px solid #222;\"><br></td>\r\n    </tr>\r\n</table>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:15px 0 0 0; padding:0; font-size:12px; font-family:sans-serif;\">\r\n\r\n    <tr style=\"margin:0; padding:0;\">\r\n\r\n        <!-- LEFT SIDE: INSTRUCTIONS TABLE -->\r\n        <td style=\"width:70%; vertical-align:top; padding:0 !important; margin:0; text-align:left;\">\r\n\r\n            <table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0;\">\r\n\r\n                <tr>\r\n                    <th style=\"border:1px solid #222; background-color:#e6e6e6; color:black; padding:4px; text-align:center; font-size:12px; margin:0;\">\r\n                        INSTRUCTIONS & CONDITIONS OF THIS ORDER\r\n                    </th>\r\n                </tr>\r\n\r\n                <tr>\r\n                    <td style=\"border:1px solid #222; padding:6px 8px; line-height:1.4; text-align:left; margin:0;\">\r\n                        1. This order must NOT be filled at HIGHER prices than shown hereon without advanced notification.<br>\r\n                        2. If shipment cannot be made on or before the date specified we reserve the right to cancel.<br>\r\n                        3. Show our purchase order number on each package, packing list, and invoice.<br>\r\n                        4. Invoices must be rendered in duplicate & attach each bill of lading to each shipment.<br>\r\n                        5. Local deliveries must be made to our receiving room not to individuals or departments.\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n        </td>\r\n\r\n\r\n        <!-- RIGHT SIDE: COPIES DISTRIBUTION TEXT -->\r\n        <td style=\"width:30%; vertical-align:middle; padding:0 0 0 15px !important; margin:0; font-weight:bold; font-size:12px; line-height:1.5; color:black; text-align:left;\">\r\n\r\n            ORIGINAL - SUPPLIER<br>\r\n            YELLOW - PURCHASING<br>\r\n            PINK - ORIGINATOR\r\n\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>",
