 "html": "<table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-family:Arial, Helvetica, sans-serif;\">\r\n    <tr style=\"margin:0; padding:0;\">\r\n\r\n        <!-- LOGO (Left - 33.33%) -->\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:middle; text-align:left;\">\r\n            <img src=\"/files/Screenshot 2026-04-21 164546.png\"\r\n                 style=\"height:80px; width:auto; display:block; margin:0;\">\r\n        </td>\r\n\r\n        <!-- QUOTATION (Center - 33.33%) -->\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:middle; text-align:center; font-size:30px; font-weight:400; color:#222; white-space:nowrap;\">\r\n            Quotation\r\n        </td>\r\n\r\n        <!-- ADDRESS (Right - 33.33% & Touched to Bottom) -->\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:bottom; text-align:right; font-size:12px; line-height:1; color:#222;\">\r\n\r\n            {% set company_address = frappe.db.get_value(\r\n                \"Address\",\r\n                doc.company_address,\r\n                [\"address_line1\", \"city\", \"state\", \"pincode\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            {% if company_address %}\r\n                {{ company_address.address_line1 or \"\" }}<br>\r\n                {{ company_address.city or \"\" }},\r\n                {{ company_address.state or \"\" }},\r\n                {{ company_address.pincode or \"\" }}<br>\r\n            {% endif %}\r\n\r\n            {% set company_details = frappe.db.get_value(\r\n                \"Company\",\r\n                doc.company,\r\n                [\"website\", \"phone_no\", \"fax\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            TEL: {{ company_details.phone_no or \"\" }},\r\n            FAX {{ company_details.fax or \"\" }}<br>\r\n\r\n            {{ company_details.website or \"\" }}\r\n\r\n        </td>\r\n\r\n    </tr>\r\n</table>\r\n\r\n<div style=\"border-top:2px solid #222; margin:0; padding:0;\"></div>\r\n<div style=\"border-top:3px solid #222; margin:8px 0 0 0; padding:0;\"></div>\r\n\r\n<p style=\"margin:4px; font-size: 12px;\">\r\n    {{ frappe.utils.formatdate(doc.transaction_date, \"dd MMMM yyyy\") if doc.transaction_date else \"\" }}\r\n</p>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #222; margin:0px; padding:0; line-height:1;\">\r\n    <tr>\r\n        <td style=\"padding:10px 18px; border:1px solid #222; background-color:#d9d9d9;\">\r\n            <strong>QUOTATION TO:</strong>\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- BOTTOM ROW (2 Columns) -->\r\n    <tr>\r\n        <td style=\"padding:14px 18px; border:1px solid #222;\">\r\n            <strong>{{ doc.customer_name or \"\" }}</strong><br>\r\n            {{ doc.address_display or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<p style=\"margin:4px; font-size:10px;\">\r\n    Dear {{ doc.customer_name or \"\" }},\r\n</p>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; font-family: sans-serif; text-align: center; line-height:1;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 5%; text-align:center; color:black;\">QTY</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">ITEM CODE</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 25%; text-align:center; color:black;\">DESCRIPTION</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">NOTES</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">PRICE</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 13%; text-align:center; color:black;\">TOTAL AMOUNT</th>\r\n            <th style=\"padding: 10px; border: 1px solid #222; background-color: #e6e6e6; width: 25%; text-align:center; color:black;\">PICTURE</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <!-- QTY -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"{:,.0f}\".format(item.qty) }}\r\n            </td>\r\n            \r\n            <!-- ITEM CODE -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.item_code }}\r\n            </td>\r\n            \r\n            <!-- DESCRIPTION -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.description or \"\" }}\r\n            </td>\r\n            \r\n            <!-- NOTES -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"\" }}\r\n            </td>\r\n            \r\n            \r\n            <!-- PRICE -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.rate) }}\r\n            </td>\r\n            \r\n            <!-- TOTAL AMOUNT -->\r\n            <td style=\"padding: 10px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.amount) }}\r\n            </td>\r\n            <!-- PICTURE (Padding removed here) -->\r\n            <td style=\"padding: 0; border: 1px solid #222; vertical-align: top; text-align: center;\">\r\n                {% if item.image %}\r\n                    <img src=\"{{ item.image }}\" alt=\"{{ item.item_code }}\" style=\"height: 170px; width: auto; max-width: 100%;\">\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n  <table style=\"width: 30%; float: right; border-collapse: collapse; margin-top: 5px; font-size: 10px; border: 1px solid #222; line-height:1\">\r\n    \r\n    <!-- SUBTOTAL -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Subtotal:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money(doc.net_total or 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- SHIPPING RULE LOGIC -->\r\n    {% set shipping = None %}\r\n    {% if doc.shipping_rule %}\r\n        {% set shipping = frappe.get_doc(\"Shipping Rule\", doc.shipping_rule) %}\r\n    {% endif %}\r\n    \r\n    <!-- TAX -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Tax:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money((doc.total_taxes_and_charges or 0) - (shipping.shipping_amount if shipping else 0), currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- SHIPPING -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Shipping:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money(shipping.shipping_amount if shipping else 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- TOTAL -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; font-weight: bold; background-color: #f9f9f9;\">\r\n            Total:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right; font-weight: bold; background-color: #f9f9f9;\">\r\n            {{ frappe.utils.fmt_money(doc.grand_total or 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n</table>",
