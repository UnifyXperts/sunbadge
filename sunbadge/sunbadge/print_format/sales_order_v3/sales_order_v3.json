 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div id=\"header-html\" class=\"visible-pdf\">\n    <table style=\"width: 100%; border-collapse: collapse; font-family: Arial, Helvetica, sans-serif; margin-top:-50px;\">\n\n        <!-- ROW 2: LOGO AND ADDRESS -->\n        <tr>\n            <!-- LEFT: Logo -->\n            <td style=\"width: 33.33%; vertical-align: top; text-align: left; padding: 0;\">\n                {% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\n                \n                {% if company_logo %}\n                    <div style=\"height: 84px; overflow: hidden; position: relative; width: 100%;\">\n                        <img src=\"{{ company_logo }}\" alt=\"{{ doc.company }}\"\n                             style=\"position: absolute; top: -18px; left: 0; height: 120px; width: auto;\">\n                    </div>\n                {% endif %}\n            </td>\n            \n            <td  style=\"width: 33.33%; text-align: center; font-size: 25px; font-weight: 400; color: #222; padding-bottom: 15px;\">\n                Sales Order\n            </td>\n            <!-- RIGHT: Address -->\n            <td style=\"width:33.33%; vertical-align:top; text-align:right; font-size:12px; line-height:1.4; padding:0;\">\n            \n                {% set company_address = frappe.db.get_value(\n                    \"Address\",\n                    doc.company_address,\n                    [\"address_line1\", \"city\", \"state\", \"pincode\"],\n                    as_dict=True\n                ) %}\n            \n                {% if company_address %}\n                    {{ company_address.address_line1 or \"\" }},<br>\n                    {{ company_address.city or \"\" }},\n                    {{ company_address.state or \"\" }},\n                    {{ company_address.pincode or \"\" }}<br>\n                {% endif %}\n            \n                {% set company_details = frappe.db.get_value(\n                    \"Company\",\n                    doc.company,\n                    [\"website\", \"phone_no\", \"fax\"],\n                    as_dict=True\n                ) %}\n            \n                TEL: {{ company_details.phone_no or \"\" }},<br>\n                FAX: {{ company_details.fax or \"\" }}<br>\n            \n                {{ company_details.website or \"\" }}\n            </td>\n        </tr>\n    </table>\n    <div style=\"border-top: 2px solid #222; margin-top: 2px; padding: 0;\"></div>\n    <div style=\"border-top: 3px solid #222; margin: 4px 0 0 0; padding: 0;\"></div>\n</div>\n<div> {{ doc.contact_display or \"none\" }}</div>\n<!-- TOP ROW -->\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #222; margin-top:5px; padding:0; line-height:1; font-size:12px;\">\n    <tr>\n        \n        <!-- INVOICE / SALES # -->\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6; white-space:nowrap;\">\n            <strong>Order ID#: </strong>\n            {{ doc.name or \"\" }}\n        </td>\n        \n        <!-- ORDER DATE -->\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\n            <strong>Order Date:</strong>\n            {{ frappe.utils.formatdate(doc.transaction_date, \"dd MMM yyyy\") }}\n        </td>\n    \n        <!-- DUE DATE -->\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\n            <strong>Due Date:</strong>\n            {{ frappe.utils.formatdate(doc.delivery_date, \"dd MMM yyyy\") }}\n        </td>\n    \n        <!-- SHIP VIA -->\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\n            <strong>Ship Via:</strong>\n            {{ doc.shipping_rule or \"\" }}\n        </td>\n    </tr>\n    \n    <!-- BOTTOM ROW (2 Columns) -->\n    <tr>\n        <!-- BILL TO -->\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\n            <strong>Bill To:</strong>\n            <br>\n            {{ doc.customer_name or \"\" }}<br>\n            {{ doc.address_display or \"\" }}<br>\n            {% if doc.contact_person %}\n\n                {% if doc.contact_display %}\n                    <br><b>ATTN:</b> {{ doc.contact_display }}\n                {% endif %}\n        \n                {% if doc.contact_email %}\n                    <br><b>Email:</b> {{ doc.contact_email }}\n                {% endif %}\n\n            {% endif %}\n        </td>\n    \n        <!-- SHIP TO -->\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\n            <strong>Ship To:</strong>\n            <br>\n            {{ doc.customer_name or \"\" }}<br>\n            {{ doc.shipping_address or \"\" }}\n        </td>\n    </tr>\n</table>\n\n\n<table style=\"width: 100%; border-collapse: collapse; font-size:12px; font-family: sans-serif; text-align: center; margin-top:10px; line-height:1;\">\n    <thead>\n        <tr>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 5%; text-align:center; color:black;\">QTY</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 15%; text-align:center; color:black;\">ITEM CODE</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 21%; text-align:center; color:black;\">DESCRIPTION</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">NOTES</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 25%; text-align:center; color:black;\">PICTURE</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">PRICE</th>\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">TOTAL AMOUNT</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <!-- QTY -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; text-align:center;\">\n                {{ \"{:,.0f}\".format(item.qty) }}\n            </td>\n            \n            <!-- ITEM CODE -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; text-align:center;\">\n                {{ item.item_code }}\n            </td>\n            \n            <!-- DESCRIPTION -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; text-align:center;\">\n                {{ item.description or \"\" }}\n            </td>\n            \n            <!-- NOTES -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; text-align:center;\">\n                {{ item.custom_notes or \"\" }}\n            </td>\n            \n            <!-- PICTURE (Padding removed here) -->\n            <td style=\"padding: 0; border: 1px solid #222; vertical-align: top; text-align: center;\">\n                {% if item.image %}\n                    <img src=\"{{ item.image }}\" alt=\"{{ item.item_code }}\" style=\"height: 170px; width: auto; max-width: 100%;\">\n                {% endif %}\n            </td>\n            \n            <!-- PRICE -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap; text-align:center;\">\n                $ {{ \"{:,.2f}\".format(item.rate) }}\n            </td>\n            \n            <!-- TOTAL AMOUNT -->\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap; text-align:center;\">\n                $ {{ \"{:,.2f}\".format(item.amount) }}\n            </td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; line-height:1; table-layout:fixed;\">\n\n    <tr style=\"margin:0; padding:0;\">\n\n        <!-- LEFT SIDE: TERMS & CONDITIONS -->\n        <td style=\"width:70%; vertical-align:top; padding:0; margin:0; border:none; text-align:left;\">\n\n            {% if doc.tc_name %}\n\n                <table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; line-height:1.2;\">\n\n                    <tr>\n                        <td style=\"padding:4px 0; border:none; font-weight:bold;\">\n                            Terms & Conditions\n                        </td>\n                    </tr>\n\n                    <tr>\n                        <td style=\"padding:4px 0; border:none; vertical-align:top;\">\n                            {{ doc.terms or \"\" }}\n                        </td>\n                    </tr>\n\n                </table>\n\n            {% endif %}\n\n        </td>\n\n\n        <!-- RIGHT SIDE: TOTALS -->\n        <td style=\"width:30%; vertical-align:top; padding:0; margin:0; border:none;\">\n\n            {% set shipping = None %}\n            {% if doc.shipping_rule %}\n                {% set shipping = frappe.get_doc(\"Shipping Rule\", doc.shipping_rule) %}\n            {% endif %}\n\n            {% set ns = namespace(donation_amount=0) %}\n\n            {% for tax in doc.taxes %}\n                {% if \"Donations\" in tax.account_head %}\n                    {% set ns.donation_amount = tax.tax_amount %}\n                {% endif %}\n            {% endfor %}\n\n\n            <table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; border:1px solid #222; line-height:1;\">\n\n                <!-- SUBTOTAL -->\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Subtotal:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            doc.net_total or 0,\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n\n\n                <!-- TAX -->\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Tax:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            (doc.total_taxes_and_charges or 0)\n                            - (shipping.shipping_amount if shipping else 0)\n                            - (ns.donation_amount or 0),\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n\n\n                <!-- DONATION -->\n                {% if ns.donation_amount %}\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Donation:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            ns.donation_amount or 0,\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n                {% endif %}\n\n\n                <!-- SHIPPING -->\n                {% if shipping %}\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Shipping:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            shipping.shipping_amount or 0,\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n                {% endif %}\n\n\n                <!-- TOTAL -->\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222; font-weight:bold; background-color:#e6e6e6;\">\n                        Total:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right; font-weight:bold; background-color:#e6e6e6;\">\n                        {{ frappe.utils.fmt_money(\n                            doc.grand_total or 0,\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n\n\n                <!-- DEPOSIT -->\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Deposit:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            doc.total_advance or 0,\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n\n\n                <!-- BALANCE -->\n                <tr>\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\n                        Balance:\n                    </td>\n\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\n                        {{ frappe.utils.fmt_money(\n                            (doc.grand_total or 0) - (doc.total_advance or 0),\n                            currency=doc.currency\n                        ) }}\n                    </td>\n                </tr>\n\n            </table>\n\n        </td>\n\n    </tr>\n\n</table>",
