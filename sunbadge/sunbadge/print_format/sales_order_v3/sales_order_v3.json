 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div id=\"header-html\" class=\"visible-pdf\">\r\n<table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;vertical-align:bottom; font-family:Arial, Helvetica, sans-serif;\">\r\n    <!-- ADDED HEIGHT HERE -->\r\n    <tr style=\"margin:0; padding:0; height:70px;\">\r\n\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:bottom; text-align:left;\">\r\n            {% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n            \r\n            {% if company_logo %}\r\n                <img src=\"{{ company_logo }}\" alt=\"{{ doc.company }}\"\r\n                     style=\"height:80px; width:auto; display:block; margin:0;\">\r\n            {% endif %}\r\n        </td>\r\n\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:bottom; text-align:center; font-size:30px; font-weight:400; color:#222; white-space:nowrap;\">\r\n            Sales Order\r\n        </td>\r\n\r\n        <td style=\"width:33.33%; padding:0; margin:0; vertical-align:bottom; text-align:right; font-size:11px; line-height:1; color:#222;\">\r\n\r\n            {% set company_address = frappe.db.get_value(\r\n                \"Address\",\r\n                doc.company_address,\r\n                [\"address_line1\", \"city\", \"state\", \"pincode\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            {% if company_address %}\r\n                {{ company_address.address_line1 or \"\" }}<br>\r\n                {{ company_address.city or \"\" }},\r\n                {{ company_address.state or \"\" }},\r\n                {{ company_address.pincode or \"\" }}<br>\r\n            {% endif %}\r\n\r\n            {% set company_details = frappe.db.get_value(\r\n                \"Company\",\r\n                doc.company,\r\n                [\"website\", \"phone_no\", \"fax\"],\r\n                as_dict=True\r\n            ) %}\r\n\r\n            TEL: {{ company_details.phone_no or \"\" }},\r\n            FAX {{ company_details.fax or \"\" }}<br>\r\n            \r\n            {{ company_details.website or \"\" }}</td>\r\n\r\n    </tr>\r\n</table>\r\n\r\n<div style=\"border-top:2px solid #222; margin:0; padding:0;\"></div>\r\n<div style=\"border-top:3px solid #222; margin:4px 0 0 0; padding:0;\"></div>\r\n\r\n</div>\r\n\r\n<!-- TOP ROW -->\r\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #222; margin-top:5px; padding:0; line-height:1; font-size:12px;\">\r\n    <tr>\r\n        \r\n        <!-- INVOICE / SALES # -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#d9d9d9; white-space:nowrap;\">\r\n            <strong>Invoice / Sales#:</strong>\r\n            {{ doc.custom_order_status.split('-')[0].strip() if doc.custom_order_status else \"\" }}\r\n        </td>\r\n        \r\n        <!-- ORDER DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#d9d9d9;\">\r\n            <strong>Order Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.transaction_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- DUE DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#d9d9d9;\">\r\n            <strong>Due Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.delivery_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- SHIP VIA -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#d9d9d9;\">\r\n            <strong>Ship Via:</strong>\r\n            {{ doc.shipping_rule or \"\" }}\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- BOTTOM ROW (2 Columns) -->\r\n    <tr>\r\n        <!-- BILL TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Bill To:</strong>\r\n            <br>\r\n            {{ doc.address_display or \"\" }}\r\n        </td>\r\n    \r\n        <!-- SHIP TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Ship To:</strong>\r\n            <br>\r\n            {{ doc.shipping_address or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; font-size:12px; font-family: sans-serif; text-align: center; margin-top:10px; line-height:1;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 5%; text-align:center; color:black;\">QTY</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">ITEM CODE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 25%; text-align:center; color:black;\">DESCRIPTION</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">NOTES</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 25%; text-align:center; color:black;\">PICTURE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">PRICE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 13%; text-align:center; color:black;\">TOTAL AMOUNT</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <!-- QTY -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"{:,.0f}\".format(item.qty) }}\r\n            </td>\r\n            \r\n            <!-- ITEM CODE -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.item_code }}\r\n            </td>\r\n            \r\n            <!-- DESCRIPTION -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.description or \"\" }}\r\n            </td>\r\n            \r\n            <!-- NOTES -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.custom_notes or \"\" }}\r\n            </td>\r\n            \r\n            <!-- PICTURE (Padding removed here) -->\r\n            <td style=\"padding: 0; border: 1px solid #222; vertical-align: top; text-align: center;\">\r\n                {% if item.image %}\r\n                    <img src=\"{{ item.image }}\" alt=\"{{ item.item_code }}\" style=\"height: 170px; width: auto; max-width: 100%;\">\r\n                {% endif %}\r\n            </td>\r\n            \r\n            <!-- PRICE -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.rate) }}\r\n            </td>\r\n            \r\n            <!-- TOTAL AMOUNT -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.amount) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n  <table style=\"width: 30%; float: right; border-collapse: collapse; margin-top: 5px; font-size: 10px; border: 1px solid #222; line-height:1\">\r\n    \r\n    <!-- SUBTOTAL -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Subtotal:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money(doc.net_total or 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- SHIPPING RULE LOGIC -->\r\n    {% set shipping = None %}\r\n    {% if doc.shipping_rule %}\r\n        {% set shipping = frappe.get_doc(\"Shipping Rule\", doc.shipping_rule) %}\r\n    {% endif %}\r\n    \r\n    <!-- TAX -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Tax:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money((doc.total_taxes_and_charges or 0) - (shipping.shipping_amount if shipping else 0), currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- SHIPPING -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222;\">\r\n            Shipping:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right;\">\r\n            {{ frappe.utils.fmt_money(shipping.shipping_amount if shipping else 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- TOTAL -->\r\n    <tr>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; font-weight: bold; background-color: #e6e6e6;\">\r\n            Total:\r\n        </td>\r\n        <td style=\"padding: 4px 6px; border: 1px solid #222; text-align: right; font-weight: bold; background-color: #e6e6e6;\">\r\n            {{ frappe.utils.fmt_money(doc.grand_total or 0, currency=doc.currency) if doc else \"\" }}\r\n        </td>\r\n    </tr>\r\n\r\n</table>",
