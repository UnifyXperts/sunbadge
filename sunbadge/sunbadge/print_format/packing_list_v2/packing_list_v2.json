 "html": "<div id=\"header-html\" class=\"visible-pdf\">\r\n    <table style=\"width: 100%; border-collapse: collapse; font-family: Arial, Helvetica, sans-serif; margin-top:-50px;\">\r\n\r\n        <!-- ROW 2: LOGO AND ADDRESS -->\r\n        <tr>\r\n            <!-- LEFT: Logo -->\r\n            <td style=\"width: 33.33%; vertical-align: top; text-align: left; padding: 0;\">\r\n                {% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n                \r\n                {% if company_logo %}\r\n                    <div style=\"height: 84px; overflow: hidden; position: relative; width: 100%;\">\r\n                        <img src=\"{{ company_logo }}\" alt=\"{{ doc.company }}\"\r\n                             style=\"position: absolute; top: -18px; left: 0; height: 120px; width: auto;\">\r\n                    </div>\r\n                {% endif %}\r\n            </td>\r\n            \r\n            <td  style=\"width: 33.33%; text-align: center; font-size: 25px; font-weight: 400; color: #222; padding-bottom: 15px;\">\r\n                Packing List\r\n            </td>\r\n            <!-- RIGHT: Address -->\r\n            <td style=\"width: 33.33%; vertical-align: top; text-align: right; font-size: 12px; line-height: 1.4; padding: 0;\">\r\n                \r\n                {% set company_address = frappe.db.get_value(\r\n                    \"Address\",\r\n                    doc.company_address,\r\n                    [\"address_line1\", \"city\", \"state\", \"pincode\"],\r\n                    as_dict=True\r\n                ) %}\r\n\r\n                {% if company_address %}\r\n                    {{ company_address.address_line1 or \"\" }},<br>\r\n                    {{ company_address.city or \"\" }},\r\n                    {{ company_address.state or \"\" }},\r\n                    {{ company_address.pincode or \"\" }}<br>\r\n                {% endif %}\r\n\r\n                {% set company_details = frappe.db.get_value(\r\n                    \"Company\",\r\n                    doc.company,\r\n                    [\"website\", \"phone_no\", \"fax\"],\r\n                    as_dict=True\r\n                ) %}\r\n                TEL: {{ company_details.phone_no or \"\" }},<br>\r\n                FAX: {{ company_details.fax or \"\" }}<br>\r\n                \r\n                {{ company_details.website or \"\" }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    <div style=\"border-top: 2px solid #222; margin-top: 2px; padding: 0;\"></div>\r\n    <div style=\"border-top: 3px solid #222; margin: 4px 0 0 0; padding: 0;\"></div>\r\n</div>\r\n\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #222; margin-top:10px; padding:0; line-height:1; font-size:12px;\">\r\n    <tr>\r\n        \r\n        <!-- INVOICE / SALES # -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#e6e6e6; white-space:nowrap;\">\r\n            <strong>Invoice / Sales#:</strong>\r\n            {{ doc.custom_order_status.split('-')[0].strip() if doc.custom_order_status else \"\" }}\r\n        </td>\r\n        \r\n        <!-- ORDER DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#e6e6e6;\">\r\n            <strong>Order Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.posting_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- DUE DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#e6e6e6;\">\r\n            <strong>Due Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.due_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- SHIP VIA -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color:#e6e6e6;\">\r\n            <strong>Ship Via:</strong>\r\n            {{ doc.shipping_rule or \"\" }}\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- BOTTOM ROW (2 Columns) -->\r\n    <tr>\r\n        <!-- BILL TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Bill To:</strong>\r\n            <br>\r\n            {{ doc.address_display or \"\" }}\r\n        </td>\r\n    \r\n        <!-- SHIP TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Ship To:</strong>\r\n            <br>\r\n            {{ doc.shipping_address or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; font-size:12px; font-family: sans-serif; text-align: center; margin-top:10px; line-height:1;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">QTY</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 30%; text-align:center; color:black;\">ITEM CODE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 30%; text-align:center; color:black;\">DESCRIPTION</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 30%; text-align:center; color:black;\">NOTES</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <!-- QTY -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"{:,.0f}\".format(item.qty) }}\r\n            </td>\r\n            \r\n            <!-- ITEM CODE -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.item_code }}\r\n            </td>\r\n            \r\n            <!-- DESCRIPTION -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.description or \"\" }}\r\n            </td>\r\n            \r\n            <!-- NOTES -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.custom_notes or \"\" }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>",
