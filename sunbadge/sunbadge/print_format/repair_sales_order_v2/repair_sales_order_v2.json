 "doc_type": "Sales Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div id=\"header-html\" class=\"visible-pdf\">\r\n    <table style=\"width: 100%; border-collapse: collapse; font-family: Arial, Helvetica, sans-serif; margin-top:-50px;\">\r\n\r\n        <!-- ROW 2: LOGO AND ADDRESS -->\r\n        <tr>\r\n            <!-- LEFT: Logo -->\r\n            <td style=\"width: 33.33%; vertical-align: top; text-align: left; padding: 0;\">\r\n                {% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\r\n                \r\n                {% if company_logo %}\r\n                    <div style=\"height: 84px; overflow: hidden; position: relative; width: 100%;\">\r\n                        <img src=\"{{ company_logo }}\" alt=\"{{ doc.company }}\"\r\n                             style=\"position: absolute; top: -18px; left: 0; height: 120px; width: auto;\">\r\n                    </div>\r\n                {% endif %}\r\n            </td>\r\n            \r\n            <td  style=\"width: 33.33%; text-align: center; font-size: 25px; font-weight: 400; color: #222; padding-bottom: 15px;\">\r\n                Repair Sales Order\r\n            </td>\r\n            <!-- RIGHT: Address -->\r\n            <td style=\"width: 33.33%; vertical-align: top; text-align: right; font-size: 12px; line-height: 1.4; padding: 0;\">\r\n                \r\n                {% set company_address = frappe.db.get_value(\r\n                    \"Address\",\r\n                    doc.company_address,\r\n                    [\"address_line1\", \"city\", \"state\", \"pincode\"],\r\n                    as_dict=True\r\n                ) %}\r\n\r\n                {% if company_address %}\r\n                    {{ company_address.address_line1 or \"\" }},<br>\r\n                    {{ company_address.city or \"\" }},\r\n                    {{ company_address.state or \"\" }},\r\n                    {{ company_address.pincode or \"\" }}<br>\r\n                {% endif %}\r\n\r\n                {% set company_details = frappe.db.get_value(\r\n                    \"Company\",\r\n                    doc.company,\r\n                    [\"website\", \"phone_no\", \"fax\"],\r\n                    as_dict=True\r\n                ) %}\r\n                TEL: {{ company_details.phone_no or \"\" }},<br>\r\n                FAX: {{ company_details.fax or \"\" }}<br>\r\n                \r\n                {{ company_details.website or \"\" }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    <div style=\"border-top: 2px solid #222; margin-top: 2px; padding: 0;\"></div>\r\n    <div style=\"border-top: 3px solid #222; margin: 4px 0 0 0; padding: 0;\"></div>\r\n</div>\r\n\r\n<!-- TOP ROW -->\r\n<table style=\"width:100%; border-collapse:collapse; border:1px solid #222; margin-top:5px; padding:0; line-height:1; font-size:12px;\">\r\n    <tr>\r\n        \r\n        <!-- INVOICE / SALES # -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6; white-space:nowrap;\">\r\n            <strong>Invoice / Sales#:</strong>\r\n            {{ doc.custom_order_status.split('-')[0].strip() if doc.custom_order_status else \"\" }}\r\n        </td>\r\n        \r\n        <!-- ORDER DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\r\n            <strong>Order Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.transaction_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- DUE DATE -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\r\n            <strong>Due Date:</strong>\r\n            {{ frappe.utils.formatdate(doc.delivery_date, \"dd MMM yyyy\") }}\r\n        </td>\r\n    \r\n        <!-- SHIP VIA -->\r\n        <td style=\"width:25%; padding:4px 6px; border:1px solid #222; background-color: #e6e6e6;\">\r\n            <strong>Ship Via:</strong>\r\n            {{ doc.shipping_rule or \"\" }}\r\n        </td>\r\n    </tr>\r\n    \r\n    <!-- BOTTOM ROW (2 Columns) -->\r\n    <tr>\r\n        <!-- BILL TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Bill To:</strong>\r\n            <br>\r\n            {{ doc.customer_name or \"\" }}<br>\r\n            {{ doc.address_display or \"\" }}\r\n        </td>\r\n    \r\n        <!-- SHIP TO -->\r\n        <td colspan=\"2\" style=\"width:50%; padding:14px 18px; border:1px solid #222; vertical-align:top;\">\r\n            <strong>Ship To:</strong>\r\n            <br>\r\n            {{ doc.customer_name or \"\" }}<br>\r\n            {{ doc.shipping_address or \"\" }}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; font-size:12px; font-family: sans-serif; text-align: center; margin-top:10px; line-height:1;\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 5%; text-align:center; color:black;\">QTY</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 15%; text-align:center; color:black;\">ITEM CODE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 21%; text-align:center; color:black;\">DESCRIPTION</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 10%; text-align:center; color:black;\">NOTES</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">PRICE</th>\r\n            <th style=\"padding: 4px; font-size:12px; border: 1px solid #222; background-color: #e6e6e6; width: 12%; text-align:center; color:black;\">TOTAL AMOUNT</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.items %}\r\n        <tr>\r\n            <!-- QTY -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ \"{:,.0f}\".format(item.qty) }}\r\n            </td>\r\n            \r\n            <!-- ITEM CODE -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.item_code }}\r\n            </td>\r\n            \r\n            <!-- DESCRIPTION -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.description or \"\" }}\r\n            </td>\r\n            \r\n            <!-- NOTES -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top;\">\r\n                {{ item.custom_notes or \"\" }}\r\n            </td>\r\n            \r\n            <!-- PRICE -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.rate) }}\r\n            </td>\r\n            \r\n            <!-- TOTAL AMOUNT -->\r\n            <td style=\"padding: 4px; border: 1px solid #222; vertical-align: top; white-space: nowrap;\">\r\n                $ {{ \"{:,.2f}\".format(item.amount) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<table style=\"width: 100%; border-collapse: collapse; font-family: Arial, Helvetica, sans-serif; font-size: 12px; margin-top: 15px;\">\r\n    <!-- TABLE HEADER -->\r\n    <thead>\r\n        <tr style=\"background-color: #f8f9fa; color: #222;\">\r\n            <th style=\"width: 15%; padding: 8px; border: 1px solid #222; background-color: #e6e6e6; color:black; text-align: center;\">\r\n                Quantity\r\n            </th>\r\n            <th style=\"width: 20%; padding: 8px; border: 1px solid #222; background-color: #e6e6e6; color:black; text-align: center;\">\r\n                Repair Item Code\r\n            </th>\r\n            <th style=\"width: 15%; padding: 8px; border: 1px solid #222; background-color: #e6e6e6; color:black; text-align: center;\">\r\n                Accepted Qty\r\n            </th>\r\n            <th style=\"width: 25%; padding: 8px; border: 1px solid #222; background-color: #e6e6e6; color:black; text-align: center;\">\r\n                Repair Notes\r\n            </th>\r\n            <th style=\"width: 25%; padding: 8px; border: 1px solid #222; background-color: #e6e6e6; color:black; text-align: center;\">\r\n                Image\r\n            </th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <!-- TABLE BODY -->\r\n    <tbody>\r\n        {% for row in doc.custom_repair_item_table %}\r\n        <tr>\r\n            <td style=\"padding: 8px; border: 1px solid #222; text-align: right; vertical-align: middle; text-align: center;\">\r\n                {{ row.quantity or 0 }}\r\n            </td>\r\n            <td style=\"padding: 8px; border: 1px solid #222; text-align: left; vertical-align: middle; text-align: center;\">\r\n                {{ row.repair_item_code or \"\" }}\r\n            </td>\r\n            <td style=\"padding: 8px; border: 1px solid #222; text-align: right; vertical-align: middle; text-align: center;\">\r\n                {{ row.accepted_qty or 0 }}\r\n            </td>\r\n            <td style=\"padding: 8px; border: 1px solid #222; text-align: left; vertical-align: middle; text-align: center;\">\r\n                {{ row.repair_notes or \"\" }}\r\n            </td>\r\n            <td style=\"width: 25%; padding: 8px; border: 1px solid #222; text-align: center; vertical-align: middle; text-align: center;\">\r\n                {% if row.image %}\r\n                    <!-- max-width and max-height prevent wkhtmltopdf from stretching the cell -->\r\n                    <img src=\"{{ row.image | urlencode }}\" alt=\"{{ row.repair_item_code }}\" \r\n                         style=\"height: 170px; width: auto; max-width: 100%;\">\r\n                {% else %}\r\n                    <span style=\"color: #999; font-style: italic;\">No Image</span>\r\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n\r\n<table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; line-height:1; table-layout:fixed;\">\r\n\r\n    <tr style=\"margin:0; padding:0;\">\r\n\r\n        <!-- LEFT SIDE: TERMS & CONDITIONS -->\r\n        <td style=\"width:70%; vertical-align:top; padding:0; margin:0; border:none; text-align:left;\">\r\n\r\n            {% if doc.custom_rejected_reason or doc.custom_rejection_notes %}\r\n\r\n                <table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; line-height:1.2;\">\r\n\r\n                    <tr>\r\n                        <td style=\"padding:4px 0; border:none; font-weight:bold; color:#FF0000;\">\r\n                            Notes:-\r\n                        </td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td style=\"padding:4px 0; border:none; vertical-align:top;\">\r\n                            {{ doc.custom_rejected_reason or \"\" }}<br>\r\n                            {{ doc.custom_rejection_notes or \"\" }}\r\n                        </td>\r\n                    </tr>\r\n\r\n                </table>\r\n\r\n            {% endif %}\r\n\r\n        </td>\r\n\r\n\r\n        <!-- RIGHT SIDE: TOTALS -->\r\n        <td style=\"width:30%; vertical-align:top; padding:0; margin:0; border:none;\">\r\n\r\n            {% set shipping = None %}\r\n            {% if doc.shipping_rule %}\r\n                {% set shipping = frappe.get_doc(\"Shipping Rule\", doc.shipping_rule) %}\r\n            {% endif %}\r\n\r\n            {% set ns = namespace(donation_amount=0) %}\r\n\r\n            {% for tax in doc.taxes %}\r\n                {% if \"Donations\" in tax.account_head %}\r\n                    {% set ns.donation_amount = tax.tax_amount %}\r\n                {% endif %}\r\n            {% endfor %}\r\n\r\n\r\n            <table style=\"width:100%; border-collapse:collapse; border-spacing:0; margin:0; padding:0; font-size:10px; border:1px solid #222; line-height:1;\">\r\n\r\n                <!-- SUBTOTAL -->\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Subtotal:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            doc.net_total or 0,\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n\r\n\r\n                <!-- TAX -->\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Tax:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            (doc.total_taxes_and_charges or 0)\r\n                            - (shipping.shipping_amount if shipping else 0)\r\n                            - (ns.donation_amount or 0),\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n\r\n\r\n                <!-- DONATION -->\r\n                {% if ns.donation_amount %}\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Donation:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            ns.donation_amount or 0,\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n                {% endif %}\r\n\r\n\r\n                <!-- SHIPPING -->\r\n                {% if shipping %}\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Shipping:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            shipping.shipping_amount or 0,\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n                {% endif %}\r\n\r\n\r\n                <!-- TOTAL -->\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; font-weight:bold; background-color:#e6e6e6;\">\r\n                        Total:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right; font-weight:bold; background-color:#e6e6e6;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            doc.grand_total or 0,\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n\r\n\r\n                <!-- DEPOSIT -->\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Deposit:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            doc.total_advance or 0,\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n\r\n\r\n                <!-- BALANCE -->\r\n                <tr>\r\n                    <td style=\"padding:4px 6px; border:1px solid #222;\">\r\n                        Balance:\r\n                    </td>\r\n\r\n                    <td style=\"padding:4px 6px; border:1px solid #222; text-align:right;\">\r\n                        {{ frappe.utils.fmt_money(\r\n                            (doc.grand_total or 0) - (doc.total_advance or 0),\r\n                            currency=doc.currency\r\n                        ) }}\r\n                    </td>\r\n                </tr>\r\n\r\n            </table>\r\n\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>",
